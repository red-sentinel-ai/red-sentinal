# Solana RPC — required for mainnet; public endpoint is rate-limited and blocks browser requests
# Use a private RPC from Helius (https://helius.dev), QuickNode, or similar
NEXT_PUBLIC_SOLANA_RPC_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_NAME=

NEXTAUTH_URL=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# For production: https://app.suisentinel.xyz
# For development: http://localhost:3000
NEXTAUTH_URL=https://app.suisentinel.xyz
NEXTAUTH_SECRET=

# Bearer token for the dspy-redteam API (Practice arena + generate-config).
# Server-only — never exposed to the client.
RED_TEAM_API_AUTH=

# Novu in-app notifications
# Public application identifier — used by the <Inbox> in the topbar (client-side).
# (The Novu secret key + workflow triggering live in the backend, not here.)
NEXT_PUBLIC_NOVU_APPLICATION_IDENTIFIER=
