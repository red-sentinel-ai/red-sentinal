[Unit]
Description=Sui Sentinel Solana TEE Server
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/projects/suisentinel/sui-sentinal
ExecStart=/home/ubuntu/projects/suisentinel/sui-sentinal/src/nautilus-server/target/release/nautilus-server
Restart=on-failure
RestartSec=5
Environment=PORT=3013
Environment=RUST_LOG=info

[Install]
WantedBy=multi-user.target
