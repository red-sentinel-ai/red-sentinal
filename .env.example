# Solana RPC — required for mainnet; public endpoint is rate-limited and blocks browser requests
# Use a private RPC from Helius (https://helius.dev), QuickNode, or similar
NEXT_PUBLIC_SOLANA_RPC_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Privy — wallet connection + embedded wallets for EVM & Solana (Sui stays on dapp-kit)
# App ID from https://dashboard.privy.io (use a separate app/client per environment)
NEXT_PUBLIC_PRIVY_APP_ID=

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_NAME=

NEXTAUTH_URL=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Speech-to-speech realtime WebSocket URL (direct S2S server, e.g. wss://host/v1/realtime)
NEXT_PUBLIC_SPEECH_TO_SPEECH_URL=

# For production: https://app.redsentinel.xyz
# For development: http://localhost:3000
NEXTAUTH_URL=https://app.redsentinel.xyz
NEXTAUTH_SECRET=

# Novu in-app notifications
# Public application identifier — used by the <Inbox> in the topbar (client-side).
# (The Novu secret key + workflow triggering live in the backend, not here.)
NEXT_PUBLIC_NOVU_APPLICATION_IDENTIFIER=

# Sui JSON-RPC endpoints. These are inlined at BUILD time, so they must be set
# in the deploy environment before `next build` runs — an unset var silently
# ships the built-in default instead.
# Do NOT use fullnode.{mainnet,testnet}.sui.io — Sui's public fullnodes have
# disabled JSON-RPC, so every call returns "Method not found".
# BlockVision's shared endpoints throttle far below what an attack burst needs.
NEXT_PUBLIC_SUI_RPC_URL_MAINNET=
NEXT_PUBLIC_SUI_RPC_URL_TESTNET=

# Backend gas sponsorship for Sui transactions. When true (default), signed-in
# users get gas paid by our sponsor wallet; signed-out users fall back to
# paying their own gas. Set to false to disable sponsorship without a redeploy
# of the backend.

# Campaign Sentinel partner application notifications (WO-2)
PARTNER_APPLICATIONS_NOTIFY_EMAIL=

# ─── Stellar (Soroban) ───────────────────────────────────────────────────────
# Sentinel contract id per network (empty = not deployed yet)
NEXT_PUBLIC_STELLAR_TESTNET_CONTRACT_ID=CBJ6XDS76GYHL6KJCE2W5V7Z4ZFW2TSPL5BE7WDNKMQ4VDVLLBJIOMFM
NEXT_PUBLIC_STELLAR_MAINNET_CONTRACT_ID=
NEXT_PUBLIC_STELLAR_TESTNET_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_STELLAR_MAINNET_RPC_URL=https://soroban-rpc.stellar.org
